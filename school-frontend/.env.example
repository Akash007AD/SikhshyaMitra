# School Platform Frontend Environment Configuration
# Copy this file to .env or .env.local to customize for your environment.

# Google OAuth Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend Gateway URL (defaults to http://localhost:8080)
VITE_API_URL=http://localhost:8080
