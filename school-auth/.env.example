# School Platform Auth Service Environment Configuration
# Copy this or set these environment variables in your deployment / container.

# 64+ char secret key for HMAC-SHA256 signature verification
JWT_SECRET=LocalDevOnlySecretKeyThatIsAtLeast64CharactersLongForHS256!

# Google OAuth Web Client ID for validating Google ID tokens
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Database credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sp_auth
DB_USER=svc_auth
DB_PASS=auth_pass
